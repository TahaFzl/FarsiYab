[Unit]
Description=FarsiYab: queue index jobs for cities that are due
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=farsiyab
WorkingDirectory=/opt/farsiyab/services/api
EnvironmentFile=/etc/farsiyab/farsiyab.env
ExecStart=/opt/farsiyab/services/api/.venv/bin/farsiyab schedule
