# /etc/farsiyab/farsiyab.env — shared by the three services.
FARSIYAB_DATABASE_URL=postgresql+psycopg://farsiyab:CHANGE-ME@localhost:5432/farsiyab
FARSIYAB_BOT_URL=https://farsiyab.example.com
# Where the website's server components reach the API.
FARSIYAB_API_URL=http://127.0.0.1:8000
# Admin panel (/fa/admin). Generate with: openssl rand -hex 32. Empty turns the panel off.
FARSIYAB_ADMIN_TOKEN=
# Salts the daily hash used to rate-limit the "add a business" form. Generate like above.
FARSIYAB_SECRET_KEY=CHANGE-ME
