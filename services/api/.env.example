# Copy to .env and adjust. Every setting is in farsiyab/config.py.
FARSIYAB_DATABASE_URL=postgresql+psycopg://farsiyab:farsiyab@localhost:5432/farsiyab
# Empty = newest release in the bucket; pin one for reproducible indexes.
FARSIYAB_OVERTURE_RELEASE=
# Where the crawler says it comes from (User-Agent). Replace with the site URL once there is one.
FARSIYAB_BOT_URL=https://github.com/TahaFzl/FarsiYab
